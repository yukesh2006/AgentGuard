# ==============================================================================
# AgentGuard Backend - Environment Variables Template
# Copy to .env for local overrides (never commit real .env files to Git)
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Local SQLite path or container volume path
DATABASE_PATH=database/agentguard.db
# Alternative URI format:
# DATABASE_URL=sqlite:///./database/agentguard.db

# Security & CORS Origins
# Comma-separated or JSON list of allowed origins.
# Include local dev servers and your deployed Firebase Hosting domains:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://agentguard-ai.web.app,https://agentguard-ai.firebaseapp.com

# ML / Sentence Transformers Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

