# ==============================================================================
# AgentGuard Frontend - Environment Variables Template
# Copy to frontend/.env.local or set during production build
# ==============================================================================

# Backend API Base URL
# For local development with Vite proxy or direct localhost:
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# For deployed Firebase Hosting connected to Google Cloud Run:
# Set this to your Cloud Run service URL before running `npm run build`:
VITE_API_BASE_URL=https://agentguard-backend-PROJECT_HASH.a.run.app
