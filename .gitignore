# ==============================================================================
# AgentGuard - .gitignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Database & SQLite files
*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
database/*.sqlite3

# Frontend & Node.js
node_modules/
frontend/dist/
frontend/build/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log
logs/

# Machine Learning Models & Large Artifacts (Prevent accidental commits)
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.h5
*.pkl
*.joblib
*.ckpt

# Temporary & Data files
*.tmp
*.temp
data/*
!data/.gitkeep

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
